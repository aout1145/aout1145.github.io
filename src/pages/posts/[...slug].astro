---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { formatDate, postPath, slugOf, sortPosts } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(sortPosts);
  return posts.map((entry, index) => {
    const d = entry.data.date;
    const month = String(d.getUTCMonth() + 1).padStart(2, "0");
    return {
      params: { slug: `${d.getUTCFullYear()}/${month}/${slugOf(entry)}` },
      props: {
        entry,
        newer: posts[index - 1] ?? null,
        older: posts[index + 1] ?? null,
      },
    };
  });
}

const { entry, newer, older } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.summary}>
  <h1 CLASS="post-title">{entry.data.title}</h1>

  <p CLASS="meta">{formatDate(entry.data.date)}{entry.data.tags.length > 0 && ` · ${entry.data.tags.join(" · ")}`}</p>

  <Content />

  {(newer || older) && (
    <div CLASS="pager">
      {newer && <a HREF={postPath(newer)}>← {newer.data.title}</a>}
      {older && <a HREF={postPath(older)}>{older.data.title} →</a>}
    </div>
  )}

  <p CLASS="back"><a HREF="/archive.html">归档</a> · <a HREF="/">首页</a></p>
</Base>
